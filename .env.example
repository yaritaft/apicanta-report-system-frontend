# URL del backend (requerida)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Entorno: "development" o "production"
# development: habilita dev toolbar, mock data, magic links en tabla
# production: desactiva todas las herramientas de desarrollo
NEXT_PUBLIC_ENV=development

# Pre-rellena credenciales en el login (solo útil en development)
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=tu_password
